# Cấu hình Evidence RAG. Mỗi dòng một cặp KHOA=GIATRI; dòng bắt đầu bằng # là chú thích.
# Sửa xong thì chạy Stop-Server.bat rồi Start-Server.bat. Giá trị để trống = dùng mặc định của ứng dụng.
# Các đường dẫn (cơ sở dữ liệu, kho tài liệu, model, OCR) do bộ khởi động tự đặt theo vị trí thư mục.

# ---- Mạng ----------------------------------------------------------------------------
# Địa chỉ máy chủ web lắng nghe:
#   0.0.0.0    mọi card mạng: các máy trong LAN truy cập được  (mặc định)
#   127.0.0.1  chỉ máy này
# PostgreSQL và Ollama luôn chỉ lắng nghe 127.0.0.1, không đổi được.
EVIDENCE_LISTEN_HOST=0.0.0.0
# Cổng web cho người dùng. Cổng PostgreSQL và Ollama dưới đây được chọn khác cổng mặc định
# để không đụng PostgreSQL/Ollama đã cài trên máy. Đổi nếu cổng đã bị chương trình khác dùng.
EVIDENCE_HTTP_PORT=8800
EVIDENCE_PG_PORT=55433
EVIDENCE_OLLAMA_PORT=21434

# ---- AI ------------------------------------------------------------------------------
# LOCAL: dùng model chạy trên máy này (Ollama đi kèm), không gửi dữ liệu ra ngoài.
AI_OPERATING_MODE=LOCAL
# Hồ sơ model, phân công chức năng và model embedding chỉnh trong Admin Portal > Mô hình AI.
# Worker nền xử lý tác vụ embedding tạo từ Admin Portal (không tự chạy lại nếu không có tác vụ).
EVIDENCE_EMBEDDING_WORKER=true
# Mặc định chặn gửi dữ liệu ra dịch vụ ngoài. Giữ nguyên khi chạy offline.
EVIDENCE_REMOTE_PROCESSING_ALLOWED=false
EVIDENCE_REMOTE_EMBEDDING_ALLOWED=false
# Chỉ cần khi dùng model trên máy chủ khác trong LAN: liệt kê địa chỉ gốc chính xác, cách nhau bằng dấu phẩy.
#EVIDENCE_AI_ALLOWED_LAN_ENDPOINTS=
# Thời gian chờ mỗi lần gọi model (giây) và thời gian tối đa của một lượt hỏi đáp (giây).
#EVIDENCE_AI_TIMEOUT_SECONDS=30
#EVIDENCE_QUERY_TIMEOUT_SECONDS=45
# Khóa API không lưu ở đây. Chỉ cần nếu dùng chế độ API: nhập trong Admin Portal (mã hóa bằng DPAPI
# của tài khoản Windows chạy máy chủ, lưu ở secrets\ai-keys).

# ---- OCR PDF scan --------------------------------------------------------------------
# Tesseract đi kèm (runtime\tesseract, dữ liệu vie + eng + osd) được dùng tự động.
#EVIDENCE_OCR_LANGUAGES=vie+eng
#EVIDENCE_OCR_PAGE_TIMEOUT_SECONDS=60
#EVIDENCE_PDF_TIMEOUT_SECONDS=120

# ---- Giới hạn ------------------------------------------------------------------------
#EVIDENCE_AUTH_TTL_SECONDS=28800
#EVIDENCE_MAX_UPLOAD_BYTES=33554432
#EVIDENCE_SEARCH_RATE_PER_MINUTE=30
