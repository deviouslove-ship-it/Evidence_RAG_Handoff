# Evidence RAG settings. One KEY=VALUE per line; lines starting with # are ignored.
# Stop and start again after editing. Empty values use the built-in default.

# ---- Network -------------------------------------------------------------
# Address the web app and API listen on.
#   0.0.0.0   every network card (other computers can connect)  <- default
#   127.0.0.1 this computer only
EVIDENCE_LISTEN_HOST=0.0.0.0
EVIDENCE_HTTP_PORT=8000
# The database always listens on 127.0.0.1 only; change the port only if it is taken.
EVIDENCE_PG_PORT=55432
# Firewall profiles used by open-firewall.cmd: Private,Domain  or  Any
EVIDENCE_FIREWALL_PROFILE=Private,Domain

# ---- AI ------------------------------------------------------------------
# LOCAL: models on this machine or an approved LAN server. API: approved HTTPS provider.
# Model profiles themselves are configured in Admin Portal > AI models.
AI_OPERATING_MODE=LOCAL
LLM_ATTEMPT_BUDGET=2
EVIDENCE_AI_TIMEOUT_SECONDS=15
# Whole chat turn in seconds; AI evidence selection may use 70% of it.
EVIDENCE_QUERY_TIMEOUT_SECONDS=45
EVIDENCE_REMOTE_PROCESSING_ALLOWED=false
# Embeddings (vectors for "search by meaning") use a local model. true also allows an
# embedding profile of zone "public" (external API) in API mode, and only for documents
# whose categories allow remote processing.
EVIDENCE_REMOTE_EMBEDDING_ALLOWED=false
# Background worker that rebuilds vectors when the embedding model is changed in
# Admin Portal > AI > Embedding. Keep true (jobs resume by themselves after a restart).
EVIDENCE_EMBEDDING_WORKER=true
# Comma separated host[:port] allowed for API mode (HTTPS only).
EVIDENCE_AI_ALLOWED_REMOTE_DOMAINS=
# Comma separated exact base URLs of approved private-IP model servers (LOCAL mode).
EVIDENCE_AI_ALLOWED_LAN_ENDPOINTS=
# API keys are never stored here. Preferred: type the key in Admin Portal > AI API form; it is
# encrypted (Windows DPAPI, this server account) in EVIDENCE_SECRET_STORE_DIR, which the launcher
# sets to secrets\ai-keys. Alternative: use secret_ref "env:NAME" in Nâng cao, then add
#   NAME=your-key
# on its own line below (the launcher passes it to the server process).

# ---- OCR for scanned PDF (optional plug-in, off unless configured) -----------
# Put Tesseract 5 (tesseract.exe + DLLs + tessdata with vie, eng, osd) in runtime\tesseract
# and it is used automatically, or give the absolute path here. Runs offline.
# OCR text is never evidence until a reviewer confirms each page against the scan.
#EVIDENCE_OCR_EXECUTABLE=
#EVIDENCE_OCR_LANGUAGES=vie+eng
#EVIDENCE_OCR_TESSDATA=
#EVIDENCE_OCR_PAGE_TIMEOUT_SECONDS=60
# Whole-file extraction limit in seconds (OCR takes about 1.5 s per page on a laptop CPU).
#EVIDENCE_PDF_TIMEOUT_SECONDS=120

# ---- Search and limits ---------------------------------------------------
EVIDENCE_SEARCH_COUNT_CAP=8000
EVIDENCE_SEARCH_STATEMENT_TIMEOUT_MS=5000
EVIDENCE_SEARCH_RATE_PER_MINUTE=30
EVIDENCE_AUTH_TTL_SECONDS=28800
EVIDENCE_MAX_UPLOAD_BYTES=33554432
