# Server configuration; set these in the backend process environment.
# Restart the backend after changing mode, policy or environment secrets.
# LOCAL = Local Only (never calls an API). API = Hybrid Auto: local main route, optional
# public escalation profile per stage (ADR-007).
AI_OPERATING_MODE=LOCAL
# Default sends per request (1-10) for stages without a policy in Admin Portal.
LLM_ATTEMPT_BUDGET=2
# Per HTTP attempt (max 30). Connecting is capped at 5 s; a profile that cannot be
# reached, times out or exceeds the selection budget is skipped for 60 s, and a
# successful "Kiểm tra kết nối" in Admin Portal clears that immediately.
EVIDENCE_AI_TIMEOUT_SECONDS=15
# Whole chat turn; AI evidence selection may use at most 70 % of it.
EVIDENCE_QUERY_TIMEOUT_SECONDS=45
EVIDENCE_PDF_TIMEOUT_SECONDS=120
EVIDENCE_REMOTE_PROCESSING_ALLOWED=false
# CSV exact authorities (host, or host:port). API requires HTTPS and public zone.
# Examples: api.openai.com,generativelanguage.googleapis.com
# Google Gemini endpoint (OpenAI-compatible): https://generativelanguage.googleapis.com/v1beta/openai
# with secret_ref env:GEMINI_API_KEY (set that variable in the backend process environment).
EVIDENCE_AI_ALLOWED_REMOTE_DOMAINS=
# CSV exact OpenAI-compatible base URLs for approved private IP servers.
# Loopback IPs and localhost require no LAN allowlist; localhost connects to 127.0.0.1.
# Other DNS names are denied in LOCAL.
EVIDENCE_AI_ALLOWED_LAN_ENDPOINTS=
# In Admin Portal, use env:YOUR_AI_API_KEY as secret_ref, never the key itself.
# Remote queries also require an explicit user grant and all source categories to allow it.
# Only the "answer" stage (evidence selection, at most 3 of the top 8 verified items) uses a model.
# Cost caps, per-stage limits and the escalation profile are set in Admin Portal.
