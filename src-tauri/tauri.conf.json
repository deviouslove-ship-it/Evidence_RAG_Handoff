{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evidence RAG",
  "version": "0.1.0",
  "identifier": "vn.evidence.rag.user",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Evidence RAG",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true
      },
      {
        "label": "orb",
        "title": "Evidence RAG Orb",
        "url": "index.html#/orb",
        "width": 84,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
